                            <TextBlock Style="{StaticResource txbcolor}" VerticalAlignment="Center" HorizontalAlignment="Center"> OK</TextBlock>
                        </Border>
                    </Grid>
                    <!--Row11-->
                    <Grid  Grid.Row="10" Grid.Column="0">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">10</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="10" Grid.Column="1">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">PAN</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="10" Grid.Column="2">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="10" Grid.Column="3">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txbcolor}" VerticalAlignment="Center" HorizontalAlignment="Center"> OK</TextBlock>
                        </Border>
                    </Grid>
                    <!--Row12-->
                    <Grid  Grid.Row="11" Grid.Column="0">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">11</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="11" Grid.Column="1">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">Cam Back</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="11" Grid.Column="2" Grid.ColumnSpan="2">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}"></Border>
                    </Grid>


                    <Grid  Grid.Row="11" Grid.Column="3">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
