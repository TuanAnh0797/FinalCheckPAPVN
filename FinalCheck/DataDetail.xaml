                        </Border>
                    </Grid>
                    <!--Rownew-->
                    <Grid  Grid.Row="9" Grid.Column="0">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">9</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="9" Grid.Column="1">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">WI 2</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="9" Grid.Column="2">
                        
                        <Border BorderThickness="1" Style="{StaticResource bordertable}" >

                        </Border>
                       
                    </Grid>

                    <Grid  Grid.Row="9" Grid.Column="3">
