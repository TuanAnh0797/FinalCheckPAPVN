                        </Border>
                    </Grid>
                    <Grid  Grid.Row="6" Grid.Column="1">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">DF</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="6" Grid.Column="2">
                       
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="6" Grid.Column="3">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txbcolor}" VerticalAlignment="Center" HorizontalAlignment="Center"> OK</TextBlock>
                        </Border>
                    </Grid>
                    <!--Row8-->
                    <Grid  Grid.Row="7" Grid.Column="0">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">7</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="7" Grid.Column="1">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">TEMP</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="7" Grid.Column="2" >
                        <Border BorderThickness="1" Style="{StaticResource bordertable}"></Border>
                    </Grid>


                    <Grid  Grid.Row="7" Grid.Column="3">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txbcolor}" VerticalAlignment="Center" HorizontalAlignment="Center"> OK</TextBlock>
                        </Border>
                    </Grid>
                    

                    <!--Row9-->
                    <Grid  Grid.Row="8" Grid.Column="0">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">8</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="8" Grid.Column="1">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">IOT</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="8" Grid.Column="2">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="8" Grid.Column="3">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
