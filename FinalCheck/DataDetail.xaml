<Window x:Class="FinalCheck.DataDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalCheck"
        
        mc:Ignorable="d"
        xmlns:uc="clr-namespace:FinalCheck.MyUserControl"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Name="MyControlBarTA"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
         WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        Title="DataDetail" Height="700" Width="850" Loaded="MyControlBarTA_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <!--<RowDefinition Height="50"></RowDefinition>-->
        </Grid.RowDefinitions>
        <uc:TitleBar Grid.Row="0">
        </uc:TitleBar>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Name="txb_namecabi" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="30" FontWeight="Medium" Text="Name Cabi"></TextBlock>
            <Border Margin="5,0,5,5"  Grid.Column="1" Grid.Row="1" BorderThickness="0" BorderBrush="White" Background="#FFD6CFCF" >
                <Grid>
                    <Grid.Resources>
                        <Style TargetType="Border" x:Key="bordertable">
                            <Setter Property="BorderBrush" Value="White"></Setter>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="txbcolor">
                            <Setter Property="FontSize" Value="15"></Setter>
                            <Setter Property="FontWeight" Value="Heavy"></Setter>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="NG">
                                    <Setter Property="Foreground" Value="Red"></Setter>
                                </Trigger>
                                <Trigger Property="Text" Value="OK">
                                    <Setter Property="Foreground" Value="Green"></Setter>
                                </Trigger>
                                <Trigger Property="Text" Value="Pending">
                                    <Setter Property="Foreground" Value="Orange"></Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="txb_column1">
                            <Setter Property="FontSize" Value="15"></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"></ColumnDefinition>
                        <ColumnDefinition Width="100"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="65"></ColumnDefinition>
                        <ColumnDefinition Width="50"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <!--Row1-->
                    <Grid  Grid.Row="0" Grid.Column="0" Background="#FF35B888">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}" Grid.Column="0">
                            <TextBlock FontSize="16" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Center">STT</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="0" Grid.Column="1" Background="#FF35B888">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}" >
                            <TextBlock FontSize="16" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Center">Content</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="4" Background="#FF35B888">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}" >


                        </Border>
                    </Grid>
                    <Grid  Grid.Row="0" Grid.Column="3" Background="#FF35B888">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock FontSize="16" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Center">Result</TextBlock>


                        </Border>
                    </Grid>
                    <Grid  Grid.Row="0" Grid.Column="4" Background="#FF35B888">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock FontSize="16" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Center">Total</TextBlock>
                        </Border>
                    </Grid>

                    <!--Row2-->
                    <Grid  Grid.Row="1" Grid.Column="0">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">1</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="1" Grid.Column="1">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">VP</TextBlock>
                        </Border>
                    </Grid>
                    
                    <Grid  Grid.Row="1" Grid.Column="2">
                        
                        <Border BorderThickness="1" Style="{StaticResource bordertable}" >
                           
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}"></Border>
                    </Grid>
                    <Grid  Grid.Row="1" Grid.Column="3">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txbcolor}" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Pending"> </TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="1" Grid.Column="4" Grid.RowSpan="13">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txbcolor}" VerticalAlignment="Center" HorizontalAlignment="Center" Text="OK"> </TextBlock>
                        </Border>
                    </Grid>

                    <!--Row3-->
                    <Grid  Grid.Row="2" Grid.Column="0">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">2</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="2" Grid.Column="1">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock  Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">GAS</TextBlock>
                        </Border>
                    </Grid>
                    <Grid  Grid.Row="2" Grid.Column="2">
                        
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                           
                        </Border>
                       
                    </Grid>

                    <Grid  Grid.Row="2" Grid.Column="3">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txbcolor}" VerticalAlignment="Center" HorizontalAlignment="Center"> OK</TextBlock>
                        </Border>
                    </Grid>

