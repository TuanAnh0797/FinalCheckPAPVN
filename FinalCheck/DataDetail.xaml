                    <Grid  Grid.Row="3" Grid.Column="0">
                        <Border BorderThickness="1" Style="{StaticResource bordertable}">
                            <TextBlock Style="{StaticResource txb_column1}" VerticalAlignment="Center" HorizontalAlignment="Center">3</TextBlock>
