<Window x:Class="FinalCheck.Setup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalCheck"
        mc:Ignorable="d"
         xmlns:uc="clr-namespace:FinalCheck.MyUserControl"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Name="MyControlBarTA"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
         WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        Title="Setup" Height="400" Width="700" Closed="MyControlBarTA_Closed" Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <!--<RowDefinition Height="50"></RowDefinition>-->
        </Grid.RowDefinitions>
        <uc:TitleBar Grid.Row="0">
        </uc:TitleBar>
        <Grid Grid.Row="1" Background="White">
            <Grid Margin="5" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock HorizontalAlignment="Center" FontSize="25" FontWeight="Medium" Text="Setup Connection"></TextBlock>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel VerticalAlignment="Center"  Orientation="Horizontal" Margin="0,0,20,0">
                        <Label FontWeight="Medium" FontSize="15">IP Address:</Label>
                        <TextBox Name="txb_ip" FontSize="15" Width="120" Text=""></TextBox>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Grid.Row="2" Orientation="Horizontal" Margin="0,0,20,0">
                        <Label FontWeight="Medium" FontSize="15">Port Number:</Label>
                        <TextBox Name="txb_port" FontSize="15" Width="70" Text=""></TextBox>
                    </StackPanel>
                    <Button Name="btn_testconnect" Click="btn_testconnect_Click" Background="DarkSeaGreen"  FontSize="15" Content="Test connect" FontWeight="Medium" Foreground="Black"></Button>
                </StackPanel>
                <Grid Grid.Row="2" Background="Black">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Background="White" Margin="1,1,0,1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="CadetBlue">
                            <Border BorderBrush="Black" BorderThickness="0,0,0,1">
                                <TextBlock Foreground="White" FontSize="20" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center">Main Form</TextBlock>
                            </Border>

                        </Grid>
                        <Grid Grid.Row="1">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center"  Orientation="Horizontal" Margin="0,0,0,5">
                                    <Label Width="150" FontWeight="Medium" FontSize="15">Alive Check(M):</Label>
                                    <TextBox Name="txb_alive"  FontSize="15" Width="70" Text=""></TextBox>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center"  Orientation="Horizontal" Margin="0,0,0,5">
                                    <Label Width="150" FontWeight="Medium" FontSize="15">Triger Data Cabi(M):</Label>
                                    <TextBox Name="txb_trigercabi" FontSize="15" Width="70" Text=""></TextBox>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                                    <Label Width="150" FontWeight="Medium" FontSize="15">Data Cabi(DM):</Label>
                                    <TextBox Name="txb_datacabi" FontSize="15"  Width="70" Text=""></TextBox>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                                    <Label Width="150" FontWeight="Medium" FontSize="15">Result Check(DM):</Label>
                                    <TextBox Name="txb_result" FontSize="15"  Width="70" Text=""></TextBox>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Grid.Column="1" Background="White" Margin="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="CadetBlue">
                            <Border BorderBrush="Black" BorderThickness="0,0,0,1">
                                <TextBlock Foreground="White" FontSize="20" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center">ERROR Form</TextBlock>
                            </Border>

                        </Grid>
                        <Grid Grid.Row="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical" Grid.Row="3" Margin="0,0,0,0">
                                <StackPanel VerticalAlignment="Center"  Orientation="Horizontal" Margin="0,0,0,5">
                                    <Label Width="150" FontWeight="Medium" FontSize="15">Triger ERROR(M):</Label>
                                    <TextBox Name="txb_trigerError" FontSize="15"  Width="70" Text=""></TextBox>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                                    <Label Width="150" FontWeight="Medium" FontSize="15">User Confirm(DM):</Label>
                                    <TextBox Name="txb_UserConfirm" FontSize="15"  Width="70" Text=""></TextBox>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                                    <Label Width="150" FontWeight="Medium" FontSize="15">Content ERROR(DM):</Label>
                                    <TextBox Name="txb_ContentError" FontSize="15"  Width="70" Text=""></TextBox>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,0">
                                    <Label Width="150" FontWeight="Medium" FontSize="15">Confirm Finish(M)</Label>
                                    <TextBox Name="txb_ConfirmFinish" FontSize="15"  Width="70" Text=""></TextBox>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid Grid.Row="3" Margin="0,5,0,0">
                    <Button Name="btn_save" Click="btn_save_Click" Background="Red" Width="200" FontSize="20">Save</Button>
                </Grid>
            </Grid>

        </Grid>

    </Grid>

</Window>
