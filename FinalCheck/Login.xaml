<Window x:Class="FinalCheck.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalCheck"
        mc:Ignorable="d"
        xmlns:uc="clr-namespace:FinalCheck.MyUserControl"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Name="MyControlBarTA"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
         WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        Title="Login" Height="240" Width="380"
        Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="MediumSeaGreen">
            <Button HorizontalAlignment="Right" Name="btn_close" Click="btn_close_Click" Foreground="White"  Height="20" Width="40" BorderBrush="Transparent" Margin="5" Padding="0" Background="Transparent" Content="{materialDesign:PackIcon Kind=CloseThick}" />
        </Grid>
        <Grid Margin="10,0,10,10" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Foreground="DarkSlateBlue" Text="Login Setup" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="40" FontWeight="DemiBold"></TextBlock>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"></RowDefinition>
                    <RowDefinition Height="45"></RowDefinition>
                    <RowDefinition Height="20"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBox x:Name="NameTextBox" materialDesign:HintAssist.Hint="User" FontSize="20">

                    </TextBox>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,0">
                    <PasswordBox  x:Name="PasswordBox" materialDesign:HintAssist.Hint="Password" FontSize="20" />
                </Grid>
                <Grid Grid.Row="2" Margin="0">
                    <TextBox Name="txbl_status" FontSize="10" Foreground="Red" Text="Incorrect password" Visibility="Hidden" >
                    </TextBox>
                </Grid>
                <Grid Grid.Row="3">
                    <Button Width="200" Name="btn_login" FontSize="25" Height="40" Background="DarkOliveGreen" Content="Login" Click="btn_login_Click"></Button>
                </Grid>

            </Grid>

        </Grid>


    </Grid>
</Window>
